# mainnet | testnet
NETWORK=mainnet

# Injective EVM private key that submits redeems and pays the gas (fund it with a little INJ).
# Leave empty to run read-only (lookups work, redeem returns 503).
RELAYER_PRIVATE_KEY=

PORT=3000
# 127.0.0.1 keeps the API private when a reverse proxy (Caddy, nginx) sits in front of it.
HOST=0.0.0.0

# Allowed browser origins, comma-separated. * allows any app to call the API.
CORS_ORIGIN=*

# Per-IP limits. Redeem requests use their own, stricter bucket.
RATE_LIMIT_PER_MINUTE=30
REDEEM_LIMIT_PER_MINUTE=5

# Set to true behind a reverse proxy so the client IP comes from X-Forwarded-For (needed for per-IP limits).
TRUST_PROXY=false

# Ignore transfers smaller than this many USDC (0 redeems everything).
MIN_REDEEM_USDC=0

# Address search index (SQLite). On first start it backfills this many hours of history.
DB_PATH=cctp.sqlite
INDEX_LOOKBACK_HOURS=72
INDEX_POLL_SECONDS=30

# Optional RPC overrides, comma-separated URLs act as fallbacks. Public RPCs are used otherwise,
# but they are slow and rate limited, so set real ones for production.
# RPC_INJECTIVE=
# RPC_ETHEREUM=
# RPC_ARBITRUM=
# RPC_BASE=
# RPC_OP_MAINNET=
# RPC_AVALANCHE=
# RPC_POLYGON=
# Also: RPC_UNICHAIN, RPC_LINEA, RPC_CODEX, RPC_SONIC, RPC_WORLD_CHAIN, RPC_MONAD, RPC_SEI, RPC_XDC,
# RPC_HYPEREVM, RPC_INK, RPC_PLUME, RPC_ARC, RPC_MORPH, RPC_CRONOS, RPC_PLASMA, RPC_X_LAYER
